{
	"name": "pi-freepi-bridge",
	"version": "0.1.0",
	"description": "Free OpenAI-compatible model provider for pi/OMP via the freepi-bridge local daemon",
	"keywords": [
		"pi-package",
		"pi-extension",
		"omp",
		"freepi",
		"free-models"
	],
	"author": "yayayapluto",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yayayapluto/pi-freepi-bridge.git"
	},
	"homepage": "https://github.com/yayayapluto/pi-freepi-bridge#readme",
	"bugs": {
		"url": "https://github.com/yayayapluto/pi-freepi-bridge/issues"
	},
	"type": "module",
	"main": "dist/index.js",
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"scripts": {
		"build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-tui --external:@earendil-works/pi-ai --log-level=warning",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.0.0"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2",
		"@types/node": "^26.6.5",
		"@earendil-works/pi-coding-agent": "^1.0.1"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	}
}